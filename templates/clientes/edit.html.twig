{% extends 'base.html.twig' %}

{% block title %}
  Editar Cliente
{% endblock %}

{% block body %}
  <div class="container py-5">
    <div class="mx-auto" style="max-width: 720px;">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="display-6 fw-light text-dark mb-1">Editar Cliente</h1>

          <p class="text-secondary mb-0">Actualizar información del cliente</p>
        </div>

        <a href="{{ path('app_clientes_index') }}" class="btn btn-outline-dark rounded-0 px-4">Volver</a>
      </div>

      <div class="card border-0 rounded-0 shadow-sm">
        <div class="card-body p-5">
          {{ form_start(form) }}

          <div class="row">
            <div class="col-md-12 mb-4">
              {{ form_label(form.nombre, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.nombre, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Nombre completo o razón social' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.nombre) }}</div>
            </div>

            <div class="col-md-6 mb-4">
              {{ form_label(form.dni_cuit, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.dni_cuit, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'DNI o CUIT' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.dni_cuit) }}</div>
            </div>

            <div class="col-md-6 mb-4">
              {{ form_label(form.telefono, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.telefono, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Teléfono de contacto' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.telefono) }}</div>
            </div>

            <div class="col-md-12 mb-4">
              {{ form_label(form.email, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.email, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Email de contacto' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.email) }}</div>
            </div>

            <div class="col-md-12 mb-4">
              {{ form_label(form.direccion, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.direccion, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Calle, número, piso, etc.', rows: 3 } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.direccion) }}</div>
            </div>

            <div class="col-md-4 mb-4">
              {{ form_label(form.localidad, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.localidad, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Localidad' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.localidad) }}</div>
            </div>

            <div class="col-md-4 mb-4">
              {{ form_label(form.provincia, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.provincia, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Provincia' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.provincia) }}</div>
            </div>

            <div class="col-md-4 mb-4">
              {{ form_label(form.codigo_postal, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.codigo_postal, { attr: { class: 'form-control form-control-lg rounded-0 border-secondary shadow-none', placeholder: 'Código postal' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.codigo_postal) }}</div>
            </div>

            <div class="col-md-12 mb-4">
              {{ form_label(form.condicion_iva, null, { label_attr: { class: 'form-label fw-semibold text-dark small text-uppercase' } }) }}

              {{ form_widget(form.condicion_iva, { attr: { class: 'form-select form-select-lg rounded-0 border-secondary shadow-none' } }) }}

              <div class="text-danger small mt-1">{{ form_errors(form.condicion_iva) }}</div>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mt-5">
            <a href="{{ path('app_clientes_index') }}" class="btn btn-light border rounded-0 px-4 py-2">Cancelar</a>

            <button class="btn btn-dark rounded-0 px-5 py-2">Actualizar</button>
          </div>

          {{ form_end(form) }}
        </div>
      </div>

      <div class="d-flex justify-content-end mt-3">{{ include('clientes/_delete_form.html.twig') }}</div>
    </div>
  </div>
{% endblock %}
