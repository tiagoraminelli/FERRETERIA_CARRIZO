{% extends 'base.html.twig' %}

{% block title %}VentasDetalle index{% endblock %}

{% block body %}
    <h1>VentasDetalle index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Cantidad</th>
                <th>Precio_unitario</th>
                <th>Subtotal</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ventas_detalle in ventas_detalles %}
            <tr>
                <td>{{ ventas_detalle.id }}</td>
                <td>{{ ventas_detalle.cantidad }}</td>
                <td>{{ ventas_detalle.precioUnitario }}</td>
                <td>{{ ventas_detalle.subtotal }}</td>
                <td>{{ ventas_detalle.createdAt ? ventas_detalle.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ventas_detalle.updatedAt ? ventas_detalle.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_ventas_detalle_show', {'id': ventas_detalle.id}) }}">show</a>
                    <a href="{{ path('app_ventas_detalle_edit', {'id': ventas_detalle.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ventas_detalle_new') }}">Create new</a>
{% endblock %}
