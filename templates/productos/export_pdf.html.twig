<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Listado de Productos</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Arial', sans-serif;
        padding: 10px;
        background: white;
        font-size: 10px;
      }

      .header {
        border-bottom: 2px solid #000;
        padding-bottom: 8px;
        margin-bottom: 10px;
      }

      .header h1 {
        font-size: 18px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .header .fecha {
        font-size: 9px;
        color: #666;
        margin-top: 3px;
      }

      .filtros {
        background: #f5f5f5;
        padding: 5px 10px;
        margin-bottom: 10px;
        font-size: 9px;
        border-left: 3px solid #000;
      }

      /* GRILLA: 3 columnas por fila */
      .productos-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
      }

      /* TARJETA DEL PRODUCTO */
      .producto-item {
        border: 1px solid #999;
        padding: 6px;
        page-break-inside: avoid;
        break-inside: avoid;
        font-size: 9px;
        line-height: 1.3;
        display: flex; /* Flex para dividir en 2/3 y 1/3 */
        gap: 8px; /* Espacio entre la info y el QR */
      }

      /* BLOQUE IZQUIERDO (Información + Código de Barras) */
      .bloque-info {
        flex: 2; /* Ocupa 2/3 del ancho */
        min-width: 0; /* Permite que el texto se corte con ellipsis */
        display: flex;
        flex-direction: column;
      }

      .producto-item .nombre {
        font-size: 10px;
        font-weight: bold;
        color: #000;
        text-transform: uppercase;
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .producto-item .detalle {
        font-size: 8px;
        color: #333;
        margin-bottom: 2px;
      }

      .producto-item .detalle span {
        display: inline-block;
        margin-right: 6px;
      }

      .producto-item .descripcion {
        font-size: 7px;
        color: #888;
        margin-top: 2px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Código de barras (dentro del bloque izquierdo) */
      .barcode-container {
        margin-top: auto; /* Lo empuja hacia abajo del bloque izquierdo */
        padding-top: 4px;
        border-top: 1px dashed #eee;
        text-align: center;
      }

      .barcode-container img {
        max-width: 100%;
        max-height: 30px;
        object-fit: contain;
      }

      .barcode-container .codigo-texto {
        font-size: 7px;
        font-family: 'Courier New', monospace;
        color: #333;
        margin-top: 1px;
        word-break: break-all;
      }

      /* BLOQUE DERECHO (Código QR) */
      .bloque-qr {
        flex: 1; /* Ocupa 1/3 del ancho */
        display: flex;
        flex-direction: column;
        justify-content: center; /* Centra el QR verticalmente */
        align-items: center;
        border-left: 1px solid #ddd;
        padding-left: 6px;
      }

      .bloque-qr img {
        width: 100%;
        max-width: 60px; /* Ajusta el tamaño máximo del QR según necesites */
        height: auto;
      }

      .footer {
        text-align: center;
        font-size: 8px;
        color: #999;
        border-top: 1px solid #ddd;
        padding-top: 8px;
        margin-top: 10px;
      }

      @page {
        size: A4;
        margin: 8mm;
      }

      @media print {
        body {
          padding: 0;
        }
        .producto-item {
          border-color: #666;
        }
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Listado de Productos</h1>
      <div class="fecha">Generado: {{ fecha }}</div>
    </div>

    <div class="filtros">
      <strong>Filtros aplicados:</strong>
      {% if filtros.search %}
        Búsqueda: "{{ filtros.search }}" |
      {% endif %}Categoría: {{ filtros.categoria }}
    </div>

    <div class="productos-grid">
      {% for producto in productos %}
        <div class="producto-item">

          {# BLOQUE IZQUIERDO: Info y Código de Barras #}
          <div class="bloque-info">
            <div class="nombre">{{ producto.nombre }}</div>

            <div class="detalle">
              <span><strong>ID:</strong> {{ producto.id }}</span>
              <span><strong>Cat:</strong> {{ producto.categoria ? producto.categoria.nombre : '-' }}</span>
            </div>
            <div class="detalle">
              <span><strong>Stock:</strong> {{ producto.stock|number_format(3, ',', '.') }}</span>
            </div>

            {% if producto.descripcion %}
              <div class="descripcion">{{ producto.descripcion }}</div>
            {% endif %}

            <div class="barcode-container">
              {% if producto.codigoBarra %}
                <img src="data:image/svg+xml;base64,{{ barcode_data[producto.id]|default('') }}" alt="Código de barras" />
                <div class="codigo-texto">{{ producto.codigoBarra }}</div>
              {% else %}
                <div style="font-size: 7px; color: #999;">Sin código</div>
              {% endif %}
            </div>
          </div>

          {# BLOQUE DERECHO: Código QR #}
          <div class="bloque-qr">
            {% if producto.codigoBarra and qr_data[producto.id] is defined %}
              <img src="data:image/png;base64,{{ qr_data[producto.id] }}" alt="Código QR" />
            {% endif %}
          </div>

        </div>
      {% else %}
        <div style="text-align: center; padding: 40px; color: #999; grid-column: 1 / -1;">No hay productos para mostrar</div>
      {% endfor %}
    </div>

    <div class="footer">Total de productos: {{ productos|length }} | Generado desde Sistema de Inventario</div>
  </body>
</html>
