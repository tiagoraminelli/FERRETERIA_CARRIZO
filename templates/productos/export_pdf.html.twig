<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Listado de Productos</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: 'Arial', sans-serif;
        padding: 10px;
        background: white;
        font-size: 10px;
      }
      
      .header {
        border-bottom: 2px solid #000;
        padding-bottom: 8px;
        margin-bottom: 10px;
      }
      
      .header h1 {
        font-size: 18px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      
      .header .fecha {
        font-size: 9px;
        color: #666;
        margin-top: 3px;
      }
      
      .filtros {
        background: #f5f5f5;
        padding: 5px 10px;
        margin-bottom: 10px;
        font-size: 9px;
        border-left: 3px solid #000;
      }
      
      /* 👇 GRILLA: 3 columnas por fila */
      .productos-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
      }
      
      .producto-item {
        border: 1px solid #999;
        padding: 6px;
        page-break-inside: avoid;
        break-inside: avoid;
        font-size: 9px;
        line-height: 1.3;
      }
      
      .producto-item .row {
        display: flex;
        gap: 6px;
        align-items: center;
      }
      
      .producto-item .info {
        flex: 1;
        min-width: 0;
      }
      
      .producto-item .nombre {
        font-size: 10px;
        font-weight: bold;
        color: #000;
        text-transform: uppercase;
        margin-bottom: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .producto-item .detalle {
        font-size: 8px;
        color: #333;
        margin-bottom: 2px;
      }
      
      .producto-item .detalle span {
        display: inline-block;
        margin-right: 6px;
      }
      
      /* 👇 Código de barras a la derecha dentro de cada tarjeta */
      .producto-item .barcode {
        text-align: center;
        min-width: 70px;
        max-width: 80px;
      }
      
      .producto-item .barcode img {
        max-width: 100%;
        max-height: 30px;
      }
      
      .producto-item .barcode .codigo {
        font-size: 7px;
        font-family: 'Courier New', monospace;
        color: #333;
        margin-top: 1px;
        word-break: break-all;
      }
      
      .producto-item .descripcion {
        font-size: 7px;
        color: #888;
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .footer {
        text-align: center;
        font-size: 8px;
        color: #999;
        border-top: 1px solid #ddd;
        padding-top: 8px;
        margin-top: 10px;
      }
      
      @page {
        size: A4;
        margin: 8mm;
      }
      
      @media print {
        body {
          padding: 0;
        }
        .producto-item {
          border-color: #666;
        }
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Listado de Productos</h1>
      <div class="fecha">Generado: {{ fecha }}</div>
    </div>

    <div class="filtros">
      <strong>Filtros aplicados:</strong>
      {% if filtros.search %}
        Búsqueda: "{{ filtros.search }}" |
      {% endif %}Categoría: {{ filtros.categoria }}
    </div>

    <div class="productos-grid">
      {% for producto in productos %}
        <div class="producto-item">
          <div class="row">
            <div class="info">
              <div class="nombre">{{ producto.nombre }}</div>
              <div class="detalle">
                <span><strong>ID:</strong> {{ producto.id }}</span>
                <span><strong>Cód:</strong> {{ producto.codigoBarra ? : 'Sin código' }}</span>
              </div>
              <div class="detalle">
                <span><strong>Cat:</strong> {{ producto.categoria ? producto.categoria.nombre : '-' }}</span>
              </div>
              <div class="detalle">
                <span><strong>Precio:</strong> ${{ producto.precio|number_format(2, ',', '.') }}</span>
                <span><strong>Stock:</strong> {{ producto.stock|number_format(3, ',', '.') }}</span>
              </div>
            </div>
            <div class="barcode">
              {% if producto.codigoBarra %}
                <img src="data:image/svg+xml;base64,{{ barcode_data[producto.id]|default('') }}" alt="Código de barras" />
                <div class="codigo">{{ producto.codigoBarra }}</div>
              {% else %}
                <div style="font-size: 8px; color: #999;">Sin código</div>
              {% endif %}
            </div>
          </div>
          {% if producto.descripcion %}
            <div class="descripcion">{{ producto.descripcion }}</div>
          {% endif %}
        </div>
      {% else %}
        <div style="text-align: center; padding: 40px; color: #999; grid-column: 1 / -1;">No hay productos para mostrar</div>
      {% endfor %}
    </div>

    <div class="footer">Total de productos: {{ productos|length }} | Generado desde Sistema de Inventario</div>
  </body>
</html>
