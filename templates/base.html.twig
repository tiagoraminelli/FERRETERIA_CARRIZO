<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>
      {% block title %}
        Welcome!
      {% endblock %}
    </title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>:D</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>" />

    {# Bootstrap CSS CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: 260px;
        z-index: 1030;
        overflow-y: auto;
      }

      .sidebar::-webkit-scrollbar {
        width: 4px;
      }

      .sidebar::-webkit-scrollbar-track {
        background: #212529;
      }

      .sidebar::-webkit-scrollbar-thumb {
        background: #495057;
        border-radius: 2px;
      }

      .main-content {
        margin-left: 260px;
        min-height: 100vh;
      }

      @media (max-width: 768px) {
        .sidebar {
          width: 220px;
          transform: translateX(-100%);
          transition: transform 0.3s ease;
        }

        .sidebar.show {
          transform: translateX(0);
        }

        .main-content {
          margin-left: 0;
        }

        .menu-toggle {
          display: inline-block !important;
        }
      }

      .menu-toggle {
        display: none;
        cursor: pointer;
      }

      .nav-link.active {
        background-color: #0d6efd !important;
        color: #fff !important;
      }

      .nav-link:hover {
        background-color: #2c3034;
      }
    </style>

    {% block stylesheets %}
      <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
      <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    {% endblock %}

    {% block javascripts %}
      <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
      {% block importmap %}
        {{ importmap('app') }}
      {% endblock %}

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
      <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}" />
      <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
      <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
  </head>

  <body>
    {# ============================================ #}
    {# TOGGLE BUTTON PARA MÓVIL #}
    {# ============================================ #}
    <button class="menu-toggle btn btn-dark rounded-0 position-fixed" onclick="toggleSidebar()" style="top: 10px; left: 10px; z-index: 1040; border-radius: 0 !important;"><i class="bi bi-list fs-4"></i></button>

    {# ============================================ #}
    {# SIDEBAR #}
    {# ============================================ #}
    <div class="sidebar bg-dark" id="sidebar">
      <div class="d-flex flex-column p-3">
        {# Logo #}
        <div class="text-center mb-4">
          <h5 class="text-white fw-light">Inventario</h5>
          <small class="text-secondary">Sistema de Gestión</small>
        </div>

        <hr class="text-secondary" />

        {# Dashboard #}
        <ul class="nav nav-pills flex-column mb-auto">
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}"><i class="bi bi-house-door me-2"></i> Inicio</a>
          </li>
        </ul>

        <div class="small text-secondary mt-3 mb-2">SEGURIDAD</div>

        {# Usuarios #}
        <ul class="nav nav-pills flex-column">
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_users' ? 'active' : '' }}" href="{{ path('app_users_index') }}"><i class="bi bi-people me-2"></i> Usuarios</a>
          </li>
        </ul>

        <div class="small text-secondary mt-3 mb-2">CLIENTES</div>

        {# Clientes #}
        <ul class="nav nav-pills flex-column">
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_clientes' ? 'active' : '' }}" href="{{ path('app_clientes_index') }}"><i class="bi bi-person me-2"></i> Clientes</a>
          </li>
        </ul>

        <div class="small text-secondary mt-3 mb-2">INVENTARIO</div>

        {# Productos #}
        <ul class="nav nav-pills flex-column">
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_productos' ? 'active' : '' }}" href="{{ path('app_productos_index') }}"><i class="bi bi-box-seam me-2"></i> Productos</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_categoria' ? 'active' : '' }}" href="{{ path('app_categoria_index') }}"><i class="bi bi-tags me-2"></i> Categorías</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_proveedores' ? 'active' : '' }}" href="{{ path('app_proveedores_index') }}"><i class="bi bi-truck me-2"></i> Proveedores</a>
          </li>
        </ul>

        <div class="small text-secondary mt-3 mb-2">VENTAS</div>

        {# Ventas #}
        <ul class="nav nav-pills flex-column">
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') == 'app_ventas_index' ? 'active' : '' }}" href="{{ path('app_ventas_index') }}"><i class="bi bi-list-ul me-2"></i> Listado</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') == 'app_ventas_new' ? 'active' : '' }}" href="{{ path('app_ventas_new') }}"><i class="bi bi-plus-circle me-2"></i> Nueva Venta</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_ventas_detalle' ? 'active' : '' }}" href="{{ path('app_ventas_detalle_index') }}"><i class="bi bi-receipt me-2"></i> Detalle</a>
          </li>
        </ul>

        <div class="small text-secondary mt-3 mb-2">PRESUPUESTOS</div>

        {# Presupuestos #}
        <ul class="nav nav-pills flex-column">
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') == 'app_presupuestos_index' ? 'active' : '' }}" href="{{ path('app_presupuestos_index') }}"><i class="bi bi-list-ul me-2"></i> Listado</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') == 'app_presupuestos_new' ? 'active' : '' }}" href="{{ path('app_presupuestos_new') }}"><i class="bi bi-plus-circle me-2"></i> Nuevo</a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white {{ app.request.get('_route') starts with 'app_presupuestos_detalle' ? 'active' : '' }}" href="{{ path('app_presupuestos_detalle_index') }}"><i class="bi bi-receipt me-2"></i> Detalle</a>
          </li>
        </ul>

        <hr class="text-secondary" />

        {# Usuario #}
        <ul class="nav nav-pills flex-column">
          {% if app.user %}
            <li class="nav-item">
              <a class="nav-link text-white" href="#"><i class="bi bi-person-circle me-2"></i> {{ app.user.name ?? app.user.email }}</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-danger" href="#"><i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión</a>
            </li>
          {% else %}
            <li class="nav-item">
              <a class="nav-link text-white" href="#"><i class="bi bi-box-arrow-in-right me-2"></i> Login</a>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    {# ============================================ #}
    {# CONTENIDO PRINCIPAL #}
    {# ============================================ #}
    <div class="main-content p-4 bg-light">
      {# Breadcrumb #}
      {% if breadcrumbs is defined and (breadcrumbs|length) > 0 %}
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="{{ path('app_home') }}">Inicio</a>
            </li>
            {% for crumb in breadcrumbs %}
              {% if crumb.url %}
                <li class="breadcrumb-item">
                  <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                </li>
              {% else %}
                <li class="breadcrumb-item active" aria-current="page">{{ crumb.label }}</li>
              {% endif %}
            {% endfor %}
          </ol>
        </nav>
      {% endif %}

      {# Contenido #}
      {% block body %}

      {% endblock %}
    </div>

    {# ============================================ #}
    {# MODAL + SCRIPTS #}
    {# ============================================ #}
    {{ include('_delete_modal.html.twig') }}

    <script>
      function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('show')
      }

      document.addEventListener('DOMContentLoaded', function () {
        const deleteModal = document.getElementById('deleteModal')
        const deleteForm = document.getElementById('deleteForm')
        const deleteItemName = document.getElementById('deleteItemName')
        const deleteToken = document.getElementById('deleteToken')

        document.querySelectorAll('[data-delete]').forEach((button) => {
          button.addEventListener('click', function (e) {
            e.preventDefault()

            const id = this.getAttribute('data-id')
            const name = this.getAttribute('data-name')
            let url = this.getAttribute('data-url')
            const token = this.getAttribute('data-token')

            url = url.replace('ID_PLACEHOLDER', id)

            deleteItemName.textContent = name
            deleteForm.action = url
            deleteToken.value = token

            const modal = new bootstrap.Modal(deleteModal)
            modal.show()
          })
        })
      })
    </script>
  </body>
</html>
