{#
    Vista: users/index.html.twig
#}

{% extends 'base.html.twig' %}

{% block title %}Usuarios
{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="mx-auto" style="max-width: 1150px;">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1 class="display-6 fw-light text-dark mb-1" style="letter-spacing: -1px;">
                        Usuarios
                    </h1>

                    <p class="text-secondary mb-0">
                        Manejo de usuarios registrados en el sistema
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a href="{{ path('app_users_new') }}" class="btn btn-dark rounded-0 px-4 py-2">
                        <i class="bi bi-plus-lg"></i>
                        Nuevo Usuario
                    </a>
                </div>

            </div>

            <div class="card border-0 rounded-0 shadow-sm">

                <div class="card-body p-4 border-bottom bg-light">

                    <form method="GET" action="{{ path('app_users_index') }}">

                        <div class="row g-2 align-items-center">

                            <div class="col-md-5">

                                <input type="text" name="search" value="{{ search }}" class="form-control form-control-lg rounded-0 border-secondary shadow-none" placeholder="Buscar por nombre o email...">

                            </div>

                            <div class="col-md-3">

                                <select name="verified" class="form-select form-select-lg rounded-0 border-secondary shadow-none">
                                    <option value="">Todos los estados</option>
                                    <option value="1" {{ verified == '1' ? 'selected' : '' }}>Verificados</option>
                                    <option value="0" {{ verified == '0' ? 'selected' : '' }}>No verificados</option>
                                </select>

                            </div>

                            <div class="col-auto">

                                <button class="btn btn-dark rounded-0 px-4 h-100">
                                    Buscar
                                </button>

                            </div>

                            <div class="col-auto">

                                <a href="{{ path('app_users_index') }}" class="btn btn-outline-secondary rounded-0 px-4 h-100">
                                    Limpiar
                                </a>

                            </div>

                        </div>

                    </form>

                </div>

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="border-bottom">

                            <tr class="bg-dark">

                                <th class="text-black fw-normal border-0 p-3">
                                    ID
                                </th>

                                <th class="text-black fw-normal border-0 p-3">
                                    Nombre
                                </th>

                                <th class="text-black fw-normal border-0 p-3">
                                    Email
                                </th>

                                <th class="text-black fw-normal border-0 p-3">
                                    Estado
                                </th>

                                <th class="text-black fw-normal border-0 p-3 text-end">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            {% for user in users %}

                                <tr class="border-top">

                                    <td class="p-3 text-secondary">
                                        #{{ user.id }}
                                    </td>

                                    <td class="p-3">
                                        <div class="fw-medium text-dark">
                                            {{ user.name }}
                                        </div>
                                        <small class="text-muted">
                                            {{ user.email }}
                                        </small>
                                    </td>

                                    <td class="p-3 text-secondary">
                                        {{ user.email }}
                                    </td>

                                    <td class="p-3">

                                        {% if user.emailVerifiedAt %}

                                            <span class="badge bg-dark rounded-0 px-3 py-2 fw-normal">
                                                Verificado
                                            </span>

                                        {% else %}

                                            <span class="badge bg-secondary rounded-0 px-3 py-2 fw-normal">
                                                Pendiente
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td class="p-3 text-end">

                                        <a href="{{ path('app_users_show', {'id': user.id}) }}" class="text-primary me-3" title="Ver">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a href="{{ path('app_users_edit', {'id': user.id}) }}" class="text-warning me-3" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <button type="button" class="btn btn-link text-danger p-0 m-0" style="border: none; background: none;" title="Eliminar" data-delete data-id="{{ user.id }}" data-name="{{ user.name ?? user.email }}" data-url="{{ path('app_users_delete', {'id': 'ID_PLACEHOLDER'}) }}" data-token="{{ csrf_token('delete' ~ user.id) }}">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </td>

                                </tr>

                            {% else %}

                                <tr>
                                    <td colspan="5" class="text-center py-5 text-secondary">
                                        No se encontraron usuarios
                                    </td>
                                </tr>

                            {% endfor %}

                        </tbody>

                    </table>

                </div>

                <div class="card-footer bg-white border-0 py-4">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                        <small class="text-secondary">
                            Total:
                            {{ users.getTotalItemCount }}
                            usuarios
                        </small>

                        <nav>

                            <ul class="pagination pagination-sm mb-0">

                                {% if users.currentPageNumber > 1 %}

                                    <li class="page-item">

                                        <a class="page-link rounded-0 text-dark shadow-none" href="{{ path('app_users_index', { page: users.currentPageNumber - 1, search: search, verified: verified }) }}">

                                            &laquo;

                                        </a>

                                    </li>

                                {% endif %}

                                {% set start = users.currentPageNumber - 1 %}
                                {% set end = users.currentPageNumber + 1 %}

                                {% if start < 1 %}
                                    {% set start = 1 %}
                                    {% set end = 3 %}
                                {% endif %}

                                {% if end > users.pageCount %}
                                    {% set end = users.pageCount %}
                                    {% set start = users.pageCount - 2 %}
                                {% endif %}

                                {% if start < 1 %}
                                    {% set start = 1 %}
                                {% endif %}

                                {% for page in start..end %}

                                    <li class="page-item {{ page == users.currentPageNumber ? 'active' : '' }}">

                                        <a class="page-link rounded-0 shadow-none {{ page == users.currentPageNumber ? 'bg-dark border-dark text-white' : 'text-dark' }}" href="{{ path('app_users_index', { page: page, search: search, verified: verified }) }}">

                                            {{ page }}

                                        </a>

                                    </li>

                                {% endfor %}

                                {% if users.currentPageNumber < users.pageCount %}

                                    <li class="page-item">

                                        <a class="page-link rounded-0 text-dark shadow-none" href="{{ path('app_users_index', { page: users.currentPageNumber + 1, search: search, verified: verified }) }}">

                                            &raquo;

                                        </a>

                                    </li>

                                {% endif %}

                            </ul>

                        </nav>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
