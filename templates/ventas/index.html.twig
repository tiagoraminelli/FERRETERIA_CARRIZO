{#
    Vista: ventas/index.html.twig
#}

{% extends 'base.html.twig' %}

{% block title %}
  Ventas
{% endblock %}

{% block body %}
  <div class="mx-auto" style="max-width: 1150px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="display-6 fw-light text-dark mb-1" style="letter-spacing: -1px;">Ventas</h1>

        <p class="text-secondary mb-0">Gestión de ventas del sistema</p>
      </div>

      <div class="d-flex gap-2">
        <a href="{{ path('app_ventas_new') }}" class="btn btn-dark rounded-0 px-4 py-2">
          <i class="bi bi-plus-lg"></i>
          Nueva Venta
        </a>
      </div>
    </div>

    <div class="card border-0 rounded-0 shadow-sm">
      <div class="card-body p-4 border-bottom bg-light">
        <form method="GET" action="{{ path('app_ventas_index') }}">
          <div class="row g-2 align-items-center">
            <div class="col-md-4">
              <input type="text" name="search" value="{{ search }}" class="form-control form-control-lg rounded-0 border-secondary shadow-none" placeholder="Buscar por cliente..." />
            </div>

            <div class="col-md-2">
              <select name="estado" class="form-select form-select-lg rounded-0 border-secondary shadow-none">
                <option value="">Todos los estados</option>
                <option value="pendiente" {{ estado == 'pendiente' ? 'selected' : '' }}>Pendiente</option>
                <option value="pagada" {{ estado == 'pagada' ? 'selected' : '' }}>Pagada</option>
                <option value="anulada" {{ estado == 'anulada' ? 'selected' : '' }}>Anulada</option>
              </select>
            </div>

            <div class="col-md-2">
              <select name="forma_pago" class="form-select form-select-lg rounded-0 border-secondary shadow-none">
                <option value="">Todas las formas</option>
                <option value="efectivo" {{ formaPago == 'efectivo' ? 'selected' : '' }}>Efectivo</option>
                <option value="transferencia" {{ formaPago == 'transferencia' ? 'selected' : '' }}>Transferencia</option>
                <option value="tarjeta" {{ formaPago == 'tarjeta' ? 'selected' : '' }}>Tarjeta</option>
                <option value="cuenta_corriente" {{ formaPago == 'cuenta_corriente' ? 'selected' : '' }}>Cuenta Corriente</option>
              </select>
            </div>

            <div class="col-auto">
              <button class="btn btn-dark rounded-0 px-4 h-100">Buscar</button>
            </div>

            <div class="col-auto">
              <a href="{{ path('app_ventas_index') }}" class="btn btn-outline-secondary rounded-0 px-4 h-100">Limpiar</a>
            </div>
          </div>
        </form>
      </div>

      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead class="border-bottom">
            <tr class="bg-dark">
              <th class="text-black fw-normal border-0 p-3">ID</th>

              <th class="text-black fw-normal border-0 p-3">Cliente</th>

              <th class="text-black fw-normal border-0 p-3">Fecha</th>

              <th class="text-black fw-normal border-0 p-3">Total</th>

              <th class="text-black fw-normal border-0 p-3">Forma Pago</th>

              <th class="text-black fw-normal border-0 p-3">Estado</th>

              <th class="text-black fw-normal border-0 p-3 text-end">Acciones</th>
            </tr>
          </thead>

          <tbody>
            {% for venta in ventas %}
              <tr class="border-top">
                <td class="p-3 text-secondary">#{{ venta.id }}</td>

                <td class="p-3">
                  <div class="fw-medium text-dark">{{ venta.clienteNombre }}</div>
                  <small class="text-muted">{{ venta.clienteTelefono ? : 'Sin teléfono' }}</small>
                </td>

                <td class="p-3 text-secondary">{{ venta.fecha ? venta.fecha|date('d/m/Y H:i') : '-' }}</td>

                <td class="p-3 text-success-emphasis">${{ venta.total|number_format(2, ',', '.') }}</td>

                <td class="p-3 text-secondary">{{ venta.formaPago|capitalize }}</td>

                <td class="p-3">
                  {% set estadoClass = { pendiente: 'bg-warning text-dark', pagada: 'bg-success', anulada: 'bg-danger' } %}

                  <span class="badge {{ estadoClass[venta.estado] ?? 'bg-secondary' }} rounded-0 px-3 py-2 fw-normal">{{ venta.estado|capitalize }}</span>
                </td>

                <td class="p-3 text-end">
                  <a href="{{ path('app_ventas_show', { id: venta.id }) }}" class="text-primary me-3" title="Ver"><i class="bi bi-eye"></i></a>

                  <a href="{{ path('app_ventas_edit', { id: venta.id }) }}" class="text-warning me-3" title="Editar"><i class="bi bi-pencil-square"></i></a>

                  <button type="button" class="btn btn-link text-danger p-0 m-0" style="border: none; background: none;" title="Eliminar" data-delete data-id="{{ venta.id }}" data-name="Venta #{{ venta.id }}" data-url="{{ path('app_ventas_delete', { id: 'ID_PLACEHOLDER' }) }}" data-token="{{ csrf_token('delete' ~ venta.id) }}"><i class="bi bi-trash"></i></button>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="7" class="text-center py-5 text-secondary">No se encontraron ventas</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="card-footer bg-white border-0 py-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
          <small class="text-secondary">
            Total:
            {{ ventas.getTotalItemCount }}
            ventas
          </small>

          <nav>
            <ul class="pagination pagination-sm mb-0">
              {% if ventas.currentPageNumber > 1 %}
                <li class="page-item">
                  <a class="page-link rounded-0 text-dark shadow-none" href="{{ path('app_ventas_index', { page: ventas.currentPageNumber - 1, search: search, estado: estado, forma_pago: formaPago }) }}">&laquo;</a>
                </li>
              {% endif %}

              {% set start = ventas.currentPageNumber - 1 %}
              {% set end = ventas.currentPageNumber + 1 %}

              {% if start < 1 %}
                {% set start = 1 %}
                {% set end = 3 %}
              {% endif %}

              {% if end > ventas.pageCount %}
                {% set end = ventas.pageCount %}
                {% set start = ventas.pageCount - 2 %}
              {% endif %}

              {% if start < 1 %}
                {% set start = 1 %}
              {% endif %}

              {% for page in start..end %}
                <li class="page-item {{ page == ventas.currentPageNumber ? 'active' : '' }}">
                  <a class="page-link rounded-0 shadow-none {{ page == ventas.currentPageNumber ? 'bg-dark border-dark text-white' : 'text-dark' }}" href="{{ path('app_ventas_index', { page: page, search: search, estado: estado, forma_pago: formaPago }) }}">{{ page }}</a>
                </li>
              {% endfor %}

              {% if ventas.currentPageNumber < ventas.pageCount %}
                <li class="page-item">
                  <a class="page-link rounded-0 text-dark shadow-none" href="{{ path('app_ventas_index', { page: ventas.currentPageNumber + 1, search: search, estado: estado, forma_pago: formaPago }) }}">&raquo;</a>
                </li>
              {% endif %}
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
